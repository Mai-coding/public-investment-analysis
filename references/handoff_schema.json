{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Investment Analysis Task Handoff",
  "type": "object",
  "required": ["task", "status", "target", "completed_at", "outputs", "gate_results", "key_decisions", "open_gaps"],
  "properties": {
    "task": {"type": "integer", "minimum": 1, "maximum": 5},
    "status": {"enum": ["PASS", "FAIL", "PARTIAL"]},
    "target": {"type": "string"},
    "ticker": {"type": ["string", "null"]},
    "completed_at": {"type": "string", "description": "ISO-8601 timestamp"},
    "snapshot_date": {"type": ["string", "null"]},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
          "evidence": {"type": ["string", "null"]}
        }
      }
    },
    "key_decisions": {"type": "array", "items": {"type": "string"}},
    "key_assumptions": {"type": "array", "items": {"type": "string"}},
    "open_gaps": {"type": "array", "items": {"type": "string"}},
    "next_task_inputs": {"type": "array", "items": {"type": "string"}},
    "affected_artifacts": {"type": "array", "items": {"type": "string"}}
  }
}
