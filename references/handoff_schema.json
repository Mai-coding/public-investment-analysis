{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Investment Analysis Task Handoff",
  "type": "object",
  "required": [
    "task",
    "status",
    "target",
    "completed_at",
    "outputs",
    "gate_results",
    "key_decisions",
    "open_gaps",
    "schema_version",
    "analysis_id",
    "mode",
    "revision",
    "state",
    "execution_scope",
    "snapshot_date",
    "artifacts",
    "inputs",
    "upstream_handoffs"
  ],
  "properties": {
    "task": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL"
      ]
    },
    "target": {
      "type": "string"
    },
    "ticker": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": "string",
      "description": "ISO-8601 timestamp"
    },
    "snapshot_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "checked_state_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "key_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_task_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valuation_assessment": {
      "type": "object",
      "required": [
        "metric",
        "base_year",
        "terminal_year",
        "market_priced_band",
        "evidence_supported_band",
        "confidence",
        "rationale",
        "decisive_gaps",
        "family_weights"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "base_year": {
          "type": "integer"
        },
        "terminal_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "market_priced_band": {
          "type": "string"
        },
        "evidence_supported_band": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "High",
            "Medium",
            "Low"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "decisive_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "family_weights": {
          "type": "object",
          "required": [
            "forward_comps",
            "terminal"
          ],
          "properties": {
            "forward_comps": {
              "const": 1.0
            },
            "terminal": {
              "const": 0.0
            }
          }
        }
      }
    },
    "schema_version": {
      "const": "2.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "quick_memo",
        "full_report"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "current",
        "stale"
      ]
    },
    "execution_scope": {
      "enum": [
        "staged",
        "standalone"
      ]
    },
    "scope_reason": {
      "type": "string",
      "minLength": 1
    },
    "change_reason": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fingerprint"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fingerprint"
      }
    },
    "upstream_handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "revision",
          "path",
          "sha256"
        ],
        "properties": {
          "task": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": 3
          },
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "task",
          "status"
        ]
      },
      "then": {
        "required": [
          "valuation_assessment"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_scope": {
            "const": "standalone"
          }
        }
      },
      "then": {
        "required": [
          "scope_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "stale"
          }
        }
      },
      "then": {
        "required": [
          "change_reason",
          "affected_artifacts"
        ]
      }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "x-required-gates": {
    "1": [
      "source_coverage",
      "research_depth",
      "research_review"
    ],
    "2": [
      "artifact",
      "model_linkage"
    ],
    "3": [
      "artifact",
      "valuation_sensitivity"
    ],
    "4": [
      "chart_overlap",
      "chart_visual",
      "chart_coverage"
    ],
    "5": [
      "artifact",
      "report_content",
      "final_depth",
      "final_review"
    ]
  },
  "x-upstream-tasks": {
    "1": [],
    "2": [
      1
    ],
    "3": [
      2
    ],
    "4": [
      1,
      2,
      3
    ],
    "5": [
      1,
      2,
      3,
      4
    ]
  }
}
