{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task 4 Charts Manifest",
  "type": "object",
  "required": ["charts"],
  "properties": {
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filename", "section", "source_ids", "source_snapshot", "model_ranges", "overlap_check", "visual_check", "alt_text"],
        "properties": {
          "filename": {"type": "string"},
          "section": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_snapshot": {"type": "string"},
          "model_ranges": {"type": "array", "items": {"type": "string"}},
          "overlap_check": {"const": "PASS"},
          "visual_check": {"const": "PASS"},
          "alt_text": {"type": "string"}
        }
      }
    }
  }
}
