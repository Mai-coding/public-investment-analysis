{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task 4 Charts Manifest",
  "type": "object",
  "required": [
    "charts"
  ],
  "properties": {
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "section",
          "source_ids",
          "source_snapshot",
          "model_ranges",
          "overlap_check",
          "visual_check",
          "alt_text"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_snapshot": {
            "type": "string"
          },
          "model_ranges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overlap_check": {
            "const": "PASS"
          },
          "visual_check": {
            "const": "PASS"
          },
          "alt_text": {
            "type": "string"
          },
          "overlap_method": {
            "type": "string",
            "minLength": 1
          },
          "positioning_mode": {
            "enum": [
              "quantitative",
              "qualitative"
            ]
          },
          "target_name": {
            "type": "string",
            "minLength": 1
          },
          "axes": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "object",
                "required": [
                  "label",
                  "definition",
                  "scale",
                  "split_basis"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "split_basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "y": {
                "type": "object",
                "required": [
                  "label",
                  "definition",
                  "scale",
                  "split_basis"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "split_basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "positioning_evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "name",
                "basis",
                "source_ids"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "alt_text": {
                  "pattern": "^CHART_COMPETITION_QUADRANT:"
                }
              },
              "required": [
                "alt_text"
              ]
            },
            "then": {
              "required": [
                "positioning_mode",
                "target_name",
                "axes",
                "positioning_evidence"
              ]
            }
          }
        ]
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chart_id",
          "status",
          "reason"
        ],
        "properties": {
          "chart_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "included",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          },
          "reader_question": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    }
  }
}
